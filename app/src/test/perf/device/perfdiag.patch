diff --git a/app/src/main/java/git/artdeell/skymodloader/PerfDiag.java b/app/src/main/java/git/artdeell/skymodloader/PerfDiag.java
new file mode 100644
index 0000000..2305df2
--- /dev/null
+++ b/app/src/main/java/git/artdeell/skymodloader/PerfDiag.java
@@ -0,0 +1,98 @@
+package git.artdeell.skymodloader;
+
+import android.content.Context;
+import android.content.Intent;
+import android.os.Build;
+import android.os.PowerManager;
+import android.os.SystemClock;
+import android.util.Log;
+
+import java.util.HashMap;
+import java.util.Map;
+
+public final class PerfDiag {
+    public static final String TAG = "CanvasPerf";
+    private static final Map<String, String> config = new HashMap<>();
+    private static boolean autoplay;
+    private static long thermalCalls;
+    private static long thermalLogAt;
+    private static int thermalLastReturned = Integer.MIN_VALUE;
+
+    private PerfDiag() {}
+
+    public static synchronized void capture(Intent intent) {
+        String raw = intent == null ? null : intent.getStringExtra("perfcfg");
+        if (raw == null) return;
+        config.clear();
+        for (String item : raw.split(",")) {
+            int eq = item.indexOf('=');
+            if (eq > 0) config.put(item.substring(0, eq).trim(), item.substring(eq + 1).trim());
+        }
+        autoplay = true;
+        Log.i(TAG, "config " + raw);
+    }
+
+    public static synchronized boolean takeAutoplay() {
+        boolean value = autoplay;
+        autoplay = false;
+        return value;
+    }
+
+    public static synchronized String get(String key, String fallback) {
+        String value = config.get(key);
+        return value == null ? fallback : value;
+    }
+
+    public static boolean overlayEnabled() {
+        return !get("overlay", "1").equals("0");
+    }
+
+    public static boolean cjkFont() {
+        return !get("cjk", "1").equals("0");
+    }
+
+    public static boolean liveThermal() {
+        return get("thermal", "frozen").equals("live");
+    }
+
+    public static void configureNative() {
+        String limit = get("limit", "off");
+        String prio = get("prio", "default");
+        String cpus = get("cpus", "all");
+        int limiter = limit.equals("pace30") ? 2 : limit.equals("after") ? 3 : limit.equals("afterfence") ? 4
+                : limit.equals("game") ? 5 : 1;
+        nativeConfigure(limiter, get("skip", "0").equals("1"),
+                get("latch", "0").equals("1"), !limit.equals("off"),
+                prio.equals("low") ? 1 : prio.equals("high") ? 2 : 0, intOf("depth", 24),
+                get("damage", "0").equals("1"), cpus.equals("little") ? 1 : cpus.equals("big") ? 2 : 0,
+                intOf("nice", Integer.MIN_VALUE), intOf("ptime", 0), intOf("lag", 0),
+                intOf("fallback", limiter == 5 ? 70 : 100), get("heavy", "0").equals("1"));
+    }
+
+    private static int intOf(String key, int fallback) {
+        try {
+            return Integer.parseInt(get(key, String.valueOf(fallback)));
+        } catch (NumberFormatException e) {
+            return fallback;
+        }
+    }
+
+    public static synchronized void thermalCall(int returned, Context context) {
+        thermalCalls++;
+        long now = SystemClock.uptimeMillis();
+        if (returned == thermalLastReturned && now - thermalLogAt < 5000) return;
+        int framework = -1;
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q && context != null) {
+            PowerManager pm = (PowerManager) context.getSystemService(Context.POWER_SERVICE);
+            if (pm != null) framework = pm.getCurrentThermalStatus();
+        }
+        Log.i(TAG, "thermal calls=" + thermalCalls + " returned=" + returned + " framework=" + framework
+                + " mode=" + (liveThermal() ? "live" : "frozen"));
+        thermalLastReturned = returned;
+        thermalLogAt = now;
+    }
+
+    private static native void nativeConfigure(int limiter, boolean skip, boolean latch, boolean limitFps,
+                                               int prio, int depth, boolean damage, int cpus, int nice, int presentLead,
+                                               int lag, int fallback, boolean heavy);
+}
