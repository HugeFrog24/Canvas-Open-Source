<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/buttons"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialog_server_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_server_title"
        android:textColor="@color/text"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/dialog_server_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_server_subtitle"
        android:textColor="@color/text"
        android:textSize="12sp"
        android:alpha="0.55"
        android:layout_marginBottom="16dp" />

    <!-- Container for dynamic server options -->
    <LinearLayout
        android:id="@+id/dialog_server_list_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Cancel button -->
    <Button
        android:id="@+id/dialog_server_cancel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/buttons_3"
        android:text="@string/cancel"
        android:textColor="@color/text"
        android:textSize="13sp" />

</LinearLayout>
