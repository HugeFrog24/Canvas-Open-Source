<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/buttons"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_offsets_title"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="14dp" />

    <TextView
        android:id="@+id/dialog_offsets_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.4"
        android:alpha="0.8"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/dialog_offsets_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/offsets_note"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:letterSpacing="0.05"
        android:alpha="0.45"
        android:layout_marginBottom="20dp" />

    <!-- Import Offsets -->
    <LinearLayout
        android:id="@+id/dialog_offsets_import"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/buttons"
        android:padding="14dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/import_offsets"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/offsets_import_desc"
                android:textSize="12sp"
                android:alpha="0.5"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="22sp"
            android:alpha="0.4" />

    </LinearLayout>

    <!-- Join Discord -->
    <LinearLayout
        android:id="@+id/dialog_offsets_discord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/buttons"
        android:padding="14dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/join_discord"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/offsets_discord_desc"
                android:textSize="12sp"
                android:alpha="0.5"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="22sp"
            android:alpha="0.4" />

    </LinearLayout>

    <TextView
        android:id="@+id/dialog_offsets_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cancel"
        android:textSize="13sp"
        android:alpha="0.4"
        android:layout_gravity="end"
        android:padding="4dp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
